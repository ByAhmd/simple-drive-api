# Copy to .env for local development (loaded by dotenv in development and
# test only; production reads real environment variables). Placeholder values
# only: never commit a real token or credential.

# Shared secret clients send as "Authorization: Bearer <token>".
# Generate one with: bin/rails secret   (or: openssl rand -hex 32)
SIMPLE_DRIVE_API_TOKEN=replace-with-a-long-random-token

# Where blob bytes are kept: local | database | s3
STORAGE_BACKEND=local

# Largest accepted blob, in decoded bytes (default 10 MiB).
SIMPLE_DRIVE_MAX_BLOB_BYTES=10485760

# --- local backend ---------------------------------------------------------
# Directory for blob files; relative paths are resolved from the app root.
LOCAL_STORAGE_PATH=storage/blobs

# --- s3 backend (AWS S3, MinIO, DigitalOcean Spaces, ...) -------------------
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=simple-drive
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# Path-style addressing (http://host/bucket/key) is what MinIO expects; set to
# false for virtual-hosted style (http://bucket.host/key).
# S3_PATH_STYLE=true
# Optional key prefix inside the bucket, e.g. "blobs".
# S3_KEY_PREFIX=
# Read/write timeout per request, in seconds.
# S3_TIMEOUT_SECONDS=30
